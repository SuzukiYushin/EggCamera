dist-proto/
EggCameraIPhone/.build/
EggCameraUserUI/src/assets/NEW/

# 管理画面で追加されるランタイムのフレーム（flame_sample.png のみ追跡）
data/assets/frames/*
!data/assets/frames/.gitkeep
!data/assets/frames/flame_sample.png
data/deferred/*
!data/deferred/.gitkeep
data/failed/*
!data/failed/.gitkeep
data/jobs/*
!data/jobs/.gitkeep
.env.slack
data/backups/
.env.watchdog
data/.soak-watch-state.json
.env.slackbot
EggCameraBot/node_modules/
data/mode.json

