R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eggcamera-photos
R2_PUBLIC_BASE_URL=
PAGES_BASE_URL=

# ── Server ──────────────────────────────────────────────
PORT=3000
STATIC_DIR=

# ── Capture trigger (Mac TriggerReceiverServer) ──────────
SWIFT_HOST=localhost
SWIFT_PORT=8082
CAPTURE_TIMEOUT_MS=25000

# ── Sessions ──────────────────────────────────────────────
SESSION_TTL_MS=1800000

# ── 長期運用テスト ────────────────────────────────────────
# フォールトインジェクション(/api/admin/chaos)の有効化。
# テスト期間のみ 1 にする。本番では必ず外す（未設定=完全無効）
#CHAOS_ENABLED=1
