# EggCamera 環境変数テンプレート（実値は .env に。.env は git 管理外）
# このファイルが env の単一ドキュメント。新しい環境変数は必ずここに追記する。

# ── Cloudflare R2 / Pages ────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=eggcamera-photos
R2_PUBLIC_BASE_URL=
PAGES_BASE_URL=

# ── Server ──────────────────────────────────────────────
PORT=3000
STATIC_DIR=

# ── 認証 ────────────────────────────────────────────────
# 管理API/管理画面の認証トークン（未設定なら認証なし＝従来どおり素通り）
ADMIN_TOKEN=
# 管理画面からの再起動に要求するパスワード。
# ※ 最重要セキュリティ。コードに既定値は持たない。実値はこの .env のみ（人が手入力）。
# ※ 未設定だと再起動APIは全拒否（fail-closed）。
REBOOT_PASSWORD=

# ── Capture trigger (Mac TriggerReceiverServer) ──────────
SWIFT_HOST=localhost
SWIFT_PORT=8082
CAPTURE_TIMEOUT_MS=25000

# ── iPhone 接続（USB設計: iproxy が localhost:8080 を iPhone:8080 へ転送） ──
IPHONE_HOST=127.0.0.1
IPHONE_PORT=8080
# IPHONE_FRAME_URL=（省略時 http://IPHONE_HOST:IPHONE_PORT/frame を使用）

# ── Sessions ──────────────────────────────────────────────
SESSION_TTL_MS=1800000

# ── 長期運用テスト ────────────────────────────────────────
# フォールトインジェクション(/api/admin/chaos)の有効化。
# テスト期間のみ 1 にする。本番では必ず外す（未設定=完全無効）
#CHAOS_ENABLED=1

# ── 別プロセスの env（同じ値を共有する場合はここを正とする） ─────────
# Slack Bot (EggCameraBot, 通常 ~/EggCamera/.env.slackbot)
#   SLACK_BOT_TOKEN=xoxb-...
#   SLACK_APP_TOKEN=xapp-...            （Socket Mode 用）
#   EGG_SERVER_URL=http://localhost:3000
#   WATCHDOG_URL=https://eggcamera-watchdog.<subdomain>.workers.dev
# Slack 通知 Webhook（Nodeサーバ）
#   SLACK_WEBHOOK_URL=
# Watchdog heartbeat (EggCameraWatchdog/heartbeat.sh)
#   BEAT_SECRET=...
# iPhone 署名 (EggCameraIPhone/iphone.sh, Makefile)
#   DEVELOPMENT_TEAM=...                （省略時はスクリプト既定）

# ── メモ: env 化できない「環境固有の直書き」一覧（機材/IP変更時は手で更新） ──
# Chrome 拡張の manifest.json は match パターンに Mac mini の IP を直書きしている
# （manifest は env を参照できないため）:
#   EggCameraTestExt/manifest.json  : http://192.168.10.104/* , http://192.168.10.108/*
#   EggCameraAdminExt/manifest.json : http://192.168.10.104/* , http://192.168.10.108/*
#   → Mac mini の IP を変えたら、この2ファイルの match を手で更新すること。
# デバイス UDID を直書きしている箇所（iPhone 機種変更時に更新）:
#   ops/launchd/com.eggcamera.iproxy.plist , EggCameraIPhone/Makefile (DEVICE_ID)
