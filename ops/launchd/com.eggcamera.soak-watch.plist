<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eggcamera.soak-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/eggcamera/EggCamera/EggCameraNode/tools/soak-watch.js</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/eggcamera/EggCamera/EggCameraNode</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string></dict>
  <key>StartInterval</key><integer>600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/Users/eggcamera/Library/Logs/eggcamera-soak-watch.log</string>
  <key>StandardErrorPath</key><string>/Users/eggcamera/Library/Logs/eggcamera-soak-watch.log</string>
</dict>
</plist>
