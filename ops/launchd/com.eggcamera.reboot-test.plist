<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  再起動テスト（3台フル: iPad→iPhone→Mac mini）。スクリプトベース／Claude非依存。
  毎日 3:00 に発火し、weekly-reboot-all.sh 内の周期ゲート(前回Mac再起動から72h未満はスキップ)で
  実質「3日に1回」実行（launchdは3日周期を直接表現できないため）。中止/スキップ回は翌日3:00に自動リトライ。
  （2026-07-16: 16:35発火+ゲート無効の暫定設定から、3:00発火+72hゲートへ正式変更）
    前リフレッシュ値ログ → iPad再起動+Safari → iPhone再起動+カメラ復帰 →
    iPad/iPhone復帰ゲート → 肥大ログtruncate → Mac mini再起動。
  Mac復帰後の復旧確認・後リフレッシュ値は post-boot-verify / post-boot-claude(launchd)が自動実行。
  Mac再起動は eggcamera-safe-reboot 経由(祖先DENYリスト方式、launchd配下はALLOW)。
  ※スケジュール窓: 6サイクル毎時テストは 0-2,5-14,17-23時。15時=再起動テスト(2日毎)、16時=復旧バッファ。
    3:00枠は 2026-07-04 に廃止（旧: 毎日3:00/15:00の2回）。
  インストール:
    cp ops/launchd/com.eggcamera.reboot-test.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.eggcamera.reboot-test.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eggcamera.reboot-test</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/eggcamera/EggCamera/ops/weekly-reboot-all.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>3</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>REBOOT_TEST_MIN_INTERVAL_H</key><string>72</string></dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/Users/eggcamera/Library/Logs/eggcamera-reboot-test.out</string>
  <key>StandardErrorPath</key><string>/Users/eggcamera/Library/Logs/eggcamera-reboot-test.err</string>
</dict>
</plist>
